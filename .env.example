# Copiar a .env.local y completar. Valores locales: ver `pnpm db:status`.

# Conexión directa a Postgres (Drizzle)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Supabase (Auth y Storage)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=copiar-de-pnpm-db-status
